# 厨房 LLM 配置模板 —— 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会入库）
# 填写位置：plgstore/.env （和本文件同目录）

# DeepSeek API Key（必填，用于：安装方式兜底 / 验货分类 / 安全评估报告 / 每日日报）
DEEPSEEK_API_KEY=sk-在这里粘贴你的key

# 以下一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GitHub API Token（可选，填了限流额度翻倍：60 → 5000 次/小时，社区数据抓取更快）
GITHUB_TOKEN=

# 网络代理（可选，走梯子时填，例如 http://127.0.0.1:7890）
HTTPS_PROXY=
HTTP_PROXY=
